{
  "expo": {
    "name": "Cuentos para Dormir",
    "slug": "cuentos-para-dormir",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111F59"
      },
      "package": "com.cuentos.dormir",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#004B80",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "light",
          "hidden": true
        }
      ],
      "expo-video",
      "./plugins/withMusicVolumeControls",
      "expo-asset"
    ],
    "scheme": "cuentos",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f424963f-803f-468d-bc21-64f27bd2c282"
      }
    },
    "owner": "adrendon"
  }
}
